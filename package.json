{
  "name": "workerstack-system-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@types/node": "26.1.1",
      "@vitest/coverage-v8": "5.1.0",
      "typescript": "7.0.2",
      "vitest": "5.1.0"
    }
  },
  "type": "module",
  "scripts": {
    "fmt": "repo fmt",
    "fmt:check": "repo fmt --check",
    "lint": "repo lint",
    "lint:fix": "repo lint --fix",
    "postinstall": "repo sync --postinstall",
    "test": "bun run --filter @workerstack/system test",
    "test:catalog-install": "bun packages/playground/scripts/catalog-install.ts",
    "test:consumers": "bun run --cwd packages/playground test",
    "test:real-install": "bun run --cwd packages/playground test:real-install",
    "test:e2e:docker": "bash packages/playground/docker/run.sh",
    "test:unit": "bun run --filter @workerstack/system test:unit",
    "test:watch": "bun run --filter @workerstack/system test:watch",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.4.4",
    "@workerstack/repo": "0.2.1"
  },
  "packageManager": "bun@1.4.4"
}
