{
	"name": "workerstack-system-monorepo",
	"version": "0.0.1",
	"private": true,
	"workspaces": {
		"packages": [
			"packages/*",
			"examples/*",
			"e2e/*"
		],
		"catalog": {
			"@types/node": "26.1.1",
			"@vitest/coverage-v8": "4.1.10",
			"oxfmt": "0.63.0",
			"oxlint": "1.78.0",
			"typescript": "7.0.2",
			"vitest": "4.1.10"
		}
	},
	"type": "module",
	"scripts": {
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"postinstall": "repo sync --postinstall",
		"prepare": "lefthook install --reset-hooks-path",
		"test": "bun run --filter @workerstack/system test",
		"test:catalog-install": "bun e2e/catalog-install.ts",
		"test:consumers": "bun test e2e/app/tests",
		"test:e2e:docker": "bash e2e/docker/run.sh",
		"test:unit": "bun run --filter @workerstack/system test:unit",
		"test:watch": "bun run --filter @workerstack/system test:watch",
		"typecheck": "bun run --filter @workerstack/system type:check",
		"typecheck:consumers": "bun run --filter './examples/*' type:check && bun run --filter @workerstack/system-e2e-app type:check"
	},
	"devDependencies": {
		"@clack/prompts": "^0.11.0",
		"@commitlint/cli": "21.2.1",
		"@commitlint/config-conventional": "21.2.0",
		"@workerstack/repo": "0.2.0-rc.2",
		"lefthook": "2.2.2",
		"oxfmt": "0.63.0",
		"oxlint": "1.78.0",
		"smol-toml": "^1.8.0"
	},
	"packageManager": "bun@1.4.4"
}
