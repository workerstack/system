{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 120,
	"useTabs": true,
	"semi": false,
	"singleQuote": false,
	"ignorePatterns": [
		"dist/**",
		"coverage/**",
		"node_modules/**",
		"*.lock",
		// generated by @workerstack/repo sync
		".tmp/**",
		".agents/**",
		".claude/**",
		".codex/**",
		".grok/**",
		".cursor/**",
		".repo/**",
		".vscode/**",
		"**/references/INDEX.md",
		"**/AGENTS.md",
		"**/bunfig.toml",
		".mcp.json",
	],
}
