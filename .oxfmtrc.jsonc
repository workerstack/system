{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 120,
	"useTabs": true,
	"semi": false,
	"singleQuote": false,
	"ignorePatterns": [
		"dist/**",
		"coverage/**",
		"node_modules/**",
		"*.lock",
		// grunt-managed: regenerated by `grunt upgrade`, never hand-edited
		".agents/**",
		".claude/**",
		".codex/**",
		".gemini/**",
		".grok/**",
		".rulesync/**",
		".mcp.json",
	],
}
